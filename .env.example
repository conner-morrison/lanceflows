# Cloudflare Turnstile site key for the human-verification gate.
# Get one at: https://dash.cloudflare.com/?to=/:account/turnstile
# If unset, the build falls back to Cloudflare's "always passes" TEST key
# (1x00000000000000000000AA) — fine for local dev, NOT for production.
#
# This is a NEXT_PUBLIC_ var: it is inlined into the static build at build time,
# so set it before running `npm run build`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
